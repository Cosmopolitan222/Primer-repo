# Copia este archivo a .env.local antes de arrancar la aplicacion.
# SESSION_SECRET se usa para firmar la cookie de sesion (HMAC-SHA256).
# Genera uno propio con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-este-valor-por-uno-generado-aleatoriamente

# Ruta del fichero SQLite local (se crea automaticamente si no existe).
DATABASE_FILE=./data/verifactu.sqlite
